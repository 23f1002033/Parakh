# live | record | replay. replay needs no key.
SERPAPI_MODE=replay
SERPAPI_KEY=your-serpapi-key
DATABASE_URL=sqlite:///./parakh.db
CACHE_TTL_HOURS=24
DAILY_SEARCH_CAP=40
IP_SALT=change-me
FIXTURE_DIR=tests/fixtures/serp
CHECKS_PER_HOUR=10
REPORTS_PER_HOUR=5
# Replay only: wait about this long per engine call so demo reports fill in step by step.
REPLAY_DELAY_MS=0
